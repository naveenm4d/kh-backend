# Only public/ is meant to be served. If the web server ever reaches the app root (a clone inside
# public_html, a mis-set document root), refuse everything: .env, vendor/, storage/, the source.
# public/.htaccess re-allows its own folder.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
