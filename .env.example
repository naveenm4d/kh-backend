APP_NAME="Kulatissa Hardware"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
# Host port for the docker MariaDB, if 3306 is taken (then set DB_PORT to match).
# FORWARD_DB_PORT=3306
DB_DATABASE=kulatissa
DB_USERNAME=kulatissa
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued, and shared hosting has no worker.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# First admin account, created by `php artisan db:seed` on a fresh install.
ADMIN_NAME="Admin User"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated proxy IPs (or *) whose X-Forwarded-* headers to trust.
TRUSTED_PROXIES=

# Till session length in minutes.
SANCTUM_EXPIRATION=720

# The old Postgres install (docker compose --profile legacy up -d pgsql), read only by
# `php artisan db:copy-from-postgres`. See docs/deploy-cpanel.md.
LEGACY_PG_HOST=127.0.0.1
LEGACY_PG_PORT=5432
LEGACY_PG_DATABASE=kulatissa
LEGACY_PG_USERNAME=kulatissa
LEGACY_PG_PASSWORD=
